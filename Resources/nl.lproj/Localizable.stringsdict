<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>%lld/%lld days</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$lld/%2$#@days@</string>
		<key>days</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>many</key>
			<string>%2$lld dagen</string>
			<key>one</key>
			<string>%2$lld dag</string>
			<key>other</key>
			<string>%2$lld dagen</string>
		</dict>
	</dict>
	<key>Reach a %lld-day streak</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@days@</string>
		<key>days</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>many</key>
			<string>Bereik een reeks van %lld dagen</string>
			<key>one</key>
			<string>Bereik een reeks van %lld dag</string>
			<key>other</key>
			<string>Bereik een reeks van %lld dagen</string>
		</dict>
	</dict>
</dict>
</plist>
